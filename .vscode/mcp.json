{
  "servers": {
    "mayhem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "-e",
        "MAYHEM_URL",
        "-e",
        "MAYHEM_TOKEN",
        "ghcr.io/forallsecure/mcp-server-mayhem:latest",
        "uv",
        "run",
        "mcp-server-mayhem",
        "mcp"
      ],
      "env": {
        "MAYHEM_TOKEN": "${input:mayhem_token}",
        "MAYHEM_URL": "${input:mayhem_url}"
      },
      "type": "stdio"
    }
  },
  "inputs": [
    {
      "id": "mayhem_token",
      "type": "promptString",
      "description": "MAYHEM_TOKEN (Mayhem API key)"
    },
    {
      "id": "mayhem_url",
      "type": "promptString",
      "description": "MAYHEM_URL (Mayhem API URL)"
    }
  ]
}
