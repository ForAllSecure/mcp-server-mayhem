{
  "mcpServers": {
    "mayhem": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "-e",
        "MAYHEM_URL",
        "-e",
        "MAYHEM_TOKEN",
        "ghcr.io/forallsecure/mcp-server-mayhem:latest",
        "uv",
        "run",
        "mcp-server-mayhem",
        "mcp"
      ]
    }
  }
}
